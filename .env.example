# ============================================================
# ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to ".env" and fill in the real values.
# NEVER commit the real .env (it is git-ignored).
# ============================================================

# Application
APP_ENV=production
APP_URL=https://cevidyamandir.com

# ------------------------------------------------------------
# Production database (Hostinger) — set these on the server
# ------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=u937949366_cevm
DB_USER=u937949366_cevm
DB_PASS=YOUR_PRODUCTION_DB_PASSWORD
DB_CHARSET=utf8mb4
DB_PREFIX=cevm_

